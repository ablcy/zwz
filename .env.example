# ============================================================
#  VoxScript 配置文件示例
#  用法：复制本文件为 .env，按需修改。所有项都有合理默认值，可全部留空。
# ============================================================

# ---------- 服务 ----------
VOXSCRIPT_HOST=127.0.0.1
VOXSCRIPT_PORT=8000
# 任务数据目录（下载的媒体、提取的音频、转写结果都存这里）
# VOXSCRIPT_DATA_DIR=./data
# 同时执行的任务数。1 最稳（模型只加载一份）；显存充足可调大
MAX_WORKERS=1
# 单文件上传上限（MB）
MAX_UPLOAD_MB=800

# 允许跨域的来源（GitHub Pages 等静态页面调用本后端时必须放开）
# 逗号分隔多个；* 表示任意来源（不携带 Cookie）。生产可收紧：
#   CORS_ORIGINS=https://ablcy.github.io
# CORS_ORIGINS=*

# ---------- 语音识别引擎 ----------
# 可选：faster-whisper（本地，默认） | openai（任意 OpenAI 兼容接口） | mock（无模型假数据，用于跑通界面）
ASR_BACKEND=faster-whisper

# --- faster-whisper 参数 ---
# tiny / base / small / medium / large-v3 / distil-large-v3
WHISPER_MODEL=small
# auto / cpu / cuda
WHISPER_DEVICE=auto
# auto / int8 / int8_float16 / float16 / float32
WHISPER_COMPUTE_TYPE=auto
# 模型下载缓存目录（可选）
# WHISPER_CACHE_DIR=./models

# --- OpenAI 兼容 ASR 参数（ASR_BACKEND=openai 时生效）---
# 官方：https://api.openai.com/v1 ；也可填 Groq / SiliconFlow / 本地 vLLM 等兼容地址
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_ASR_MODEL=whisper-1
OPENAI_TIMEOUT=300

# ---------- 说话人分离 ----------
DIARIZATION_ENABLED=true
# 需要 HuggingFace Token：https://huggingface.co/settings/tokens
# 并先在模型页点同意协议：
#   1) https://huggingface.co/pyannote/speaker-diarization-3.1
#   2) https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
# 0 表示让模型自动判断人数；填 2/3/4 可显著提速且更准
DIARIZATION_NUM_SPEAKERS=0
# 分离失败时是否自动降级为「单一说话人 A」继续出稿（true 强烈推荐）
DIARIZATION_FALLBACK=true

# ---------- 视频下载 ----------
# 需要登录才能看的平台（抖音/小红书/B站会员内容），导出浏览器 Cookie 后填这里
# YTDLP_COOKIES=./cookies.txt
# 或直接读本机浏览器 Cookie（chrome / edge / firefox）
# YTDLP_COOKIES_FROM_BROWSER=
# 代理（部分平台需要）
# YTDLP_PROXY=http://127.0.0.1:7890
# 自定义 ffmpeg 路径（不填则自动查找 PATH / imageio-ffmpeg）
# FFMPEG_BINARY=C:/ffmpeg/bin/ffmpeg.exe
